# Copy to `.env` and fill in. `.env` is gitignored; this file is committed.
# When adding variables here, update the schema in "/src/env.js" too.

# --- Database ---------------------------------------------------------------
# Production is Supabase. Two connection strings, because a serverless runtime
# and a migration want opposite things from a connection — see README.
#
#   DATABASE_URL  transaction pooler, port 6543, ?pgbouncer=true&connection_limit=1
#   DIRECT_URL    session pooler,     port 5432, used only by `prisma migrate`
#
# Both go through aws-0-<region>.pooler.supabase.com. The direct host
# db.<ref>.supabase.co is IPv6-only, which Vercel cannot dial.
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# Locally, either point these at Supabase or run the container instead:
# `npm run db:start` (host port 5433).
DATABASE_URL="postgresql://postgres:password@localhost:5433/plannr"
DIRECT_URL="postgresql://postgres:password@localhost:5433/plannr"
#
# The integration tests ignore both of these and read .env.test, which is
# committed and points at the local container. They empty tables as they run,
# and vitest.integration.config.ts refuses to start against a non-local host.

# --- Auth -------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Authorized redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only Google Workspace accounts on this domain may sign in.
GOOGLE_WORKSPACE_DOMAIN="sicsr.ac.in"
# Comma-separated emails seeded as ADMIN, so the first admin exists before
# anyone signs in. First sign-in links the Google account to the seeded row.
SEED_ADMIN_EMAILS=""

# --- Email ------------------------------------------------------------------
# console = log to stdout (dev), resend = Resend API, smtp = Nodemailer SMTP_URL
EMAIL_PROVIDER="console"
EMAIL_ENABLED="false"
EMAIL_FROM="Plannr <notifications@example.com>"
RESEND_API_KEY=""
SMTP_URL=""

# Bearer token for POST /api/cron/outbox (email retry sweep) and for
# /api/cron/calendar (the Google Calendar drain). Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>`; without it, both endpoints stay shut.
CRON_SECRET=""

# --- Google Calendar sync ---------------------------------------------------
# Off by default. On, people can connect their own Google Calendar from the
# schedule screen and their classes are mirrored into a calendar Plannr creates.
# See "Google Calendar sync" in the README for the console setup.
#
# The same OAuth client as sign-in, so nothing new is needed there except one
# more authorised redirect URI:
#   http://localhost:3000/api/calendar/callback
#   https://<your-domain>/api/calendar/callback
# and the Google Calendar API enabled on the project.
GOOGLE_CALENDAR_SYNC_ENABLED="false"
# Seals the stored refresh tokens. Generate with: openssl rand -base64 32
# Changing it makes every existing connection unreadable — they reconnect.
CALENDAR_TOKEN_KEY=""

# --- Supabase ---------------------------------------------------------------
# The project's HTTP API. Nothing reads these yet — the app reaches Postgres
# through Prisma, not supabase-js — but they are what Storage or realtime would
# need. The publishable key is public by design; the service role key is not,
# and nothing here should ever need it.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- App --------------------------------------------------------------------
# Optional override for the app's own origin, used for OAuth redirect URIs,
# link previews and outgoing email links.
#
# Leave it UNSET on Vercel: VERCEL_PROJECT_PRODUCTION_URL supplies the real
# domain there, stays put across deploys, and needs no rebuild to change. Set
# this only to point somewhere else — a tunnel while developing, say. A
# localhost value inside a Vercel deployment is refused at build time, because
# that is what sends every Google consent screen back to somebody's laptop.
# NEXT_PUBLIC_APP_URL="https://localhost.tunnel.example"
