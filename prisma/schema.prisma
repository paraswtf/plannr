// Plannr — college timetable & room scheduling.
//
// Single tenant for now, but every domain table carries `orgId` and every
// natural key is unique *within* an org, so adding tenants later is a matter of
// resolving `orgId` from the session instead of a constant.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

// Roles are rows, not an enum: an institution can define its own alongside the
// four locked ones. See src/lib/permissions.ts for the bitfield they carry.

enum RoomType {
  LECTURE
  LECTURE_HALL
  LAB
  SEMINAR
  AUDITORIUM
  STUDIO
  OTHER
}

enum RoomFeature {
  PROJECTOR
  COMPUTERS
  AC
  WHITEBOARD
  MIC
  TV
  STAGE
  SMART_BOARD
}

enum EventKind {
  CLASS // timetabled class: a group taught by a faculty member
  BOOKING // ad-hoc reservation: student study room or faculty request
  BLOCK // room unavailable: maintenance, exams
}

enum EventStatus {
  CONFIRMED
  PENDING // student booking awaiting approval
  REJECTED
  CANCELLED // whole series cancelled; single occurrences use EventException
}

enum ExceptionType {
  CANCELLED // occurrence skipped (iCal EXDATE)
  MODIFIED // occurrence overridden (iCal RECURRENCE-ID)
}

/// Which sittings a change is being asked for — the same axis an edit uses.
enum RequestScope {
  OCCURRENCE
  FOLLOWING
  SERIES
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN // the person who asked thought better of it
}

/// What somebody wants changed about a class or a booking that already exists.
///
/// A new booking does not need one of these: it can simply sit at
/// `EventStatus.PENDING` until somebody approves it, because until then it is
/// not on anybody's timetable. A change is different — the lecture is already
/// running, sixty people already have it in their week — so the proposal has to
/// live somewhere other than the event itself, and the event goes on being what
/// it is until the change is granted.
///
/// Every field here is a *proposal*. Null means "leave that as it is", which is
/// why they are all nullable and none of them is the event's own column.
model EventChangeRequest {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId String
  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("ChangeRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  scope         RequestScope @default(SERIES)
  /// Which sitting, for a change that is not to the whole series. As the rule
  /// would have produced it, matching EventException.originalStart.
  originalStart DateTime?

  newRoomId    String?
  newRoom      Room?     @relation("RequestedRoom", fields: [newRoomId], references: [id], onDelete: Cascade)
  newStartTime DateTime?
  newEndTime   DateTime?
  newTitle     String?
  /// A request to call the class off rather than move it.
  cancelling   Boolean   @default(false)
  /// Why the person is asking. Shown to whoever decides.
  reason       String?

  status       RequestStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?         @relation("ChangeDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status, createdAt])
  @@index([eventId, status])
  @@index([requestedById, status])
}

enum EmailType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_APPROVED
  BOOKING_REJECTED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())

  settings           OrgSettings?
  users              User[]
  roles              Role[]
  buildings          Building[]
  rooms              Room[]
  semesters          Semester[]
  programmes         Programme[]
  courses            Course[]
  batches            Batch[]
  groups             Group[]
  events             Event[]
  changeRequests     EventChangeRequest[]
  occurrences        EventOccurrence[]
  studentProfiles    StudentProfile[]
  facultyProfiles    FacultyProfile[]
  attendance         AttendanceSession[]
  importBatches      ImportBatch[]
  schedulePlans      SchedulePlan[]
  calendarLinks      CalendarConnection[]
  apiKeys            ApiKey[]
  scheduleFavourites ScheduleFavourite[]
  notifications      Notification[]
}

model OrgSettings {
  id    String       @id @default(cuid())
  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Booking granularity in minutes (30 or 60). Drives grid snapping.
  slotMinutes     Int   @default(60)
  /// Working window as minutes from local midnight: 480 = 08:00, 1080 = 18:00.
  dayStartMinutes Int   @default(480)
  dayEndMinutes   Int   @default(1080)
  /// ISO weekdays that are bookable: 1 = Monday … 7 = Sunday.
  workingDays     Int[] @default([1, 2, 3, 4, 5])

  blockConflicts                 Boolean @default(true)
  requireApprovalStudentBookings Boolean @default(true)
  /// Whether a change to a class or a booking somebody already holds has to be
  /// approved. On, a teacher moving their own lecture files a request; off,
  /// they move it. Bookings and changes are separate settings because they are
  /// different risks: an unapproved booking takes a room, an unapproved change
  /// moves sixty people who had already written the old time down.
  requireApprovalChanges         Boolean @default(true)
  allowStudentSelfBooking        Boolean @default(true)
  emailNotifications             Boolean @default(true)
  maxStudentBookingMinutes       Int     @default(120)

  activeSemesterId String?

  updatedAt DateTime @updatedAt
}

// ─── Auth.js adapter tables + User ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique // lowercased on write; multi-tenant: @@unique([orgId, email])
  emailVerified DateTime?
  image         String?

  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  /// Extra permission bits granted to this person alone, on top of whatever
  /// their roles carry. See src/lib/permissions.ts.
  permissions        BigInt  @default(0)
  isActive           Boolean @default(true)
  emailNotifications Boolean @default(true)

  /// When this person last used Plannr in a browser, to the nearest quarter
  /// of an hour: written by the session check at most every fifteen minutes,
  /// so using the app costs one write a quarter, not one a request. Null for
  /// somebody never seen since it began being kept.
  lastSeenAt DateTime?

  /// True for the machine identity behind an API key. Such a row can never sign
  /// in — it holds no Account and its address is on a domain Google will never
  /// vouch for — and it is filtered out of every people-facing query, because a
  /// bot is not a colleague and has no business in the staff directory.
  isServiceAccount Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                   UserRole[]
  accounts                Account[]
  sessions                Session[]
  studentProfile          StudentProfile?
  facultyProfile          FacultyProfile?
  createdEvents           Event[]                  @relation("EventCreator")
  decidedEvents           Event[]                  @relation("EventDecider")
  changeRequests          EventChangeRequest[]     @relation("ChangeRequester")
  decidedChanges          EventChangeRequest[]     @relation("ChangeDecider")
  importBatches           ImportBatch[]
  outboxEntries           EmailOutbox[]
  schedulePlans           SchedulePlan[]           @relation("PlanCreator")
  planReviews             SchedulePlanReviewer[]
  planComments            SchedulePlanComment[]    @relation("PlanCommenter")
  attendanceTaken         AttendanceSession[]      @relation("AttendanceMarker")
  calendar                CalendarConnection?
  /// The key this row is the machine identity for, if it is one.
  apiKey                  ApiKey?                  @relation("ApiKeyPrincipal")
  apiKeysOwned            ApiKey[]                 @relation("ApiKeyOwner")
  apiKeysCreated          ApiKey[]                 @relation("ApiKeyCreator")
  apiKeysRevoked          ApiKey[]                 @relation("ApiKeyRevoker")
  /// Whose schedules this person keeps one tap away.
  scheduleFavourites      ScheduleFavourite[]      @relation("FavouriteHolder")
  /// The people who keep *this* person one tap away.
  favouritedBy            ScheduleFavourite[]      @relation("FavouritePerson")
  /// The devices this person has said yes to notifications on.
  pushSubscriptions       PushSubscription[]
  /// Their inbox, and what each item still owes their devices.
  notifications           Notification[]
  /// What they have chosen to hear about, and where.
  notificationPreferences NotificationPreference[]

  @@index([orgId, name])
  @@index([orgId, email])
}

/// Whether a favourite is one of the viewer's own angles or somebody else.
enum ScheduleFavouriteKind {
  PERSPECTIVE
  PERSON
}

/// A schedule the "view as" control keeps one tap away.
///
/// Deliberately one table for two things that look different and behave
/// identically. A coordinator flipping between "my own day", "the coordinator
/// view" and the four lecturers they cover for is doing one thing — switching
/// whose schedule is on screen — and giving perspectives and people separate
/// rows would mean two lists, two orderings and two ways to star something, for
/// no gain the person using it could name.
model ScheduleFavourite {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Whose list this is.
  userId String
  user   User   @relation("FavouriteHolder", fields: [userId], references: [id], onDelete: Cascade)

  kind ScheduleFavouriteKind

  /// A perspective name for PERSPECTIVE — "student", "coordinator" — or the
  /// favourited person's id for PERSON. Kept as one column because the two are
  /// one choice to whoever made it, and because a row whose meaning depends on
  /// its `kind` is easier to read than two nullable columns and a constraint
  /// asserting exactly one of them is set.
  subject String

  /// Set only for a PERSON, and only so the database can clean up after a
  /// leaver: `subject` carries the same id and is what the app reads. Without
  /// it, deleting somebody would leave every colleague holding a favourite
  /// pointing at nobody — harmless, since resolving one drops what it cannot
  /// find, but it would accumulate for ever.
  personId String?
  person   User?   @relation("FavouritePerson", fields: [personId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, kind, subject])
  @@index([userId, createdAt])
  @@index([personId])
}

/// A named bundle of permissions. The four seeded roles (student, faculty,
/// coordinator, admin) carry a `key` and are locked: they cannot be renamed,
/// repermissioned or deleted, because the seed and the docs describe the app in
/// terms of them. Custom roles have a null key and are fully editable.
model Role {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Set only for the built-in roles: "student", "faculty", "coordinator", "admin".
  key         String?
  name        String
  description String?
  /// Permission bitfield. Implications are applied at check time, not stored.
  permissions BigInt  @default(0)
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserRole[]

  @@unique([orgId, name])
  @@unique([orgId, key])
  @@index([orgId])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt   DateTime @default(now())
  assignedById String?

  @@id([userId, roleId])
  @@index([roleId])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── People ─────────────────────────────────────────────────────────────────

model StudentProfile {
  id     String       @id @default(cuid())
  userId String       @unique
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id])

  prn String

  memberships StudentGroupMembership[]
  attendance  AttendanceRecord[]

  @@unique([orgId, prn])
  @@index([prn])
}

model FacultyProfile {
  id     String       @id @default(cuid())
  userId String       @unique
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id])

  /// Short display name used on timetable cards, e.g. "Dr. Rao".
  shortName  String?
  department String?

  assignments FacultyGroupAssignment[]
  courses     CourseFaculty[]
  events      Event[]
  occurrences EventOccurrence[]

  @@index([orgId, department])
}

// ─── Spaces ─────────────────────────────────────────────────────────────────

model Building {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])
  name  String

  rooms Room[]

  @@unique([orgId, name])
}

model Room {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  /// Display code, e.g. "A-101".
  code       String
  buildingId String
  building   Building     @relation(fields: [buildingId], references: [id], onDelete: Restrict)

  floor    Int
  capacity Int
  type     RoomType
  features RoomFeature[]
  isActive Boolean       @default(true)
  notes    String?

  events           Event[]
  changeRequests   EventChangeRequest[]      @relation("RequestedRoom")
  occurrences      EventOccurrence[]
  planRequirements SchedulePlanRequirement[]
  planSessions     SchedulePlanSession[]

  @@unique([orgId, code])
  @@index([buildingId])
  @@index([orgId, type, capacity])
}

// ─── Academic structure ─────────────────────────────────────────────────────

/**
 * A semester: one calendar the whole college keeps.
 * Everything that changes from one to the next hangs off it — which courses run,
 * which groups exist, who is in them, and every lecture and register. That is
 * what makes last year still readable: nothing is edited in place at rollover, a
 * new semester is opened beside it.
 * A batch is not *in* one semester; it passes through each of them, at a
 * different semester number each time — see BatchSemester.
 */
model Semester {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  /// As the college says it, e.g. "Autumn 2026".
  name      String
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date

  batches       BatchSemester[]
  courses       Course[]
  groups        Group[]
  events        Event[]
  schedulePlans SchedulePlan[]

  @@unique([orgId, name])
}

/**
 * A programme of study: BCA, BBA-IT, MSc-CA. It admits a batch a year and runs
 * for a fixed number of years.
 */
model Programme {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id])
  code    String
  name    String
  groups  Group[]
  batches Batch[]
  courses Course[]

  @@unique([orgId, code])
}

/**
 * Which semester number a batch is sitting in during a given semester.
 * BCA 23-27 is in its seventh in Autumn 2026 and will be in its eighth in the
 * spring. Keeping it here rather than on the batch is what lets a past semester
 * still say what it said at the time.
 */
model BatchSemester {
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  /// Roman, as the college writes it: "VII".
  number     String

  @@id([batchId, semesterId])
  @@index([semesterId])
}

/**
 * A course: one subject taught in one semester, e.g. "Deep Learning".
 * It belongs to a semester because a subject is only offered in some of them,
 * and the people teaching it change; last semester's Deep Learning is a
 * different row from this one's, which is how the history stays honest.
 * Who may teach it is a list, not a single name — the office assigns several and
 * picks one when a lecture is scheduled.
 */
model Course {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  semesterId  String
  semester    Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  programmeId String?
  programme   Programme?   @relation(fields: [programmeId], references: [id], onDelete: SetNull)

  /// The paper code the college prints, e.g. "703". Not every course has one.
  code  String?
  title String

  faculty CourseFaculty[]
  groups  GroupCourse[]
  events  Event[]

  @@unique([semesterId, programmeId, title])
  @@index([orgId])
  @@index([semesterId])
}

/// A teacher the office has cleared to take a course. Several per course.
model CourseFaculty {
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  facultyId String
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  addedAt   DateTime       @default(now())

  @@id([courseId, facultyId])
  @@index([facultyId])
}

/**
 * A course a group takes.
 * This is where a student's timetable and their attendance both come from: the
 * courses somebody is studying are the courses of the groups they are in, so
 * choosing an elective is joining a group, and nothing has to be enrolled twice.
 */
model GroupCourse {
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now())

  @@id([groupId, courseId])
  @@index([courseId])
}

/// What a group is for — one intake is split several different ways at once.
enum GroupKind {
  /// A division of the batch that attends together, e.g. "A" or "B".
  DIVISION
  /// A specialisation the batch splits into, e.g. "Finance".
  MAJOR
  /// A second, smaller specialisation.
  MINOR
  /// A group drawn from across the batch for one elective — not a Course
  /// itself, but the set of people who chose it.
  SUBJECT
  OTHER
}

/**
 * An intake: the cohort admitted to a programme in a given year, e.g. "23-27
 * BBA-IT". It outlives any one semester, passing through each at a different
 * number — the divisions, majors and electives it splits into are the groups
 * that actually sit in rooms.
 */
model Batch {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  programmeId String
  programme   Programme    @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  /// How it is written down, e.g. "23-27 BBA-IT".
  name      String
  /// Calendar year the intake started, e.g. 2023.
  startYear Int
  /// Calendar year it is expected to finish, e.g. 2027.
  endYear   Int

  groups    Group[]
  semesters BatchSemester[]

  @@unique([orgId, name])
  @@index([orgId, programmeId])
}

model Group {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  programmeId String
  programme   Programme    @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  semesterId  String?
  semester    Semester?    @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  /// The intake this belongs to. Optional: an elective may draw from several.
  batchId     String?
  batch       Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)

  /// Section name, e.g. "BCA-A".
  name  String
  /// Display label including semester, e.g. "BCA-A · Sem III".
  label String?
  /// How the batch is being divided here.
  kind  GroupKind @default(DIVISION)

  students           StudentGroupMembership[]
  faculty            FacultyGroupAssignment[]
  courses            GroupCourse[]
  events             Event[]
  occurrences        EventOccurrence[]
  planRequirements   SchedulePlanRequirement[]
  planSessions       SchedulePlanSession[]
  eventGroups        EventGroup[]
  attendanceSessions AttendanceSession[]

  @@unique([programmeId, semesterId, name])
  @@index([orgId])
  @@index([batchId])
}

model StudentGroupMembership {
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedAt   DateTime       @default(now())
  addedById String?

  @@id([studentId, groupId])
  @@index([groupId])
}

model FacultyGroupAssignment {
  facultyId String
  faculty   FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedAt   DateTime       @default(now())

  @@id([facultyId, groupId])
  @@index([groupId])
}

// ─── Events & recurrence ────────────────────────────────────────────────────

model Event {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id])
  kind   EventKind
  status EventStatus  @default(CONFIRMED)
  title  String

  roomId     String
  room       Room            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  groupId    String?
  group      Group?          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  facultyId  String?
  faculty    FacultyProfile? @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  semesterId String?
  semester   Semester?       @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  /// The subject this lecture teaches. A room booking has none.
  courseId   String?
  course     Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// Who approved or refused this booking, and what they said about it. Kept
  /// apart from `notes`, which belongs to whoever asked: a refusal that
  /// overwrites the request destroys the only record of what was wanted.
  decidedById  String?
  decidedBy    User?     @relation("EventDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  /// First occurrence as UTC instants — this is DTSTART plus a duration.
  startTime DateTime
  endTime   DateTime
  /// IANA zone the recurrence is expressed in. Occurrences repeat at the same
  /// *wall clock* time in this zone, not at a fixed UTC offset.
  timezone  String   @default("Asia/Kolkata")
  /// Bare RFC 5545 RRULE value with no DTSTART line, e.g.
  /// "FREQ=WEEKLY;BYDAY=TU;UNTIL=20261215T235959". Null means a one-off.
  rrule     String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exceptions  EventException[]
  occurrences EventOccurrence[]
  requests    EventChangeRequest[]
  /// Every group attending. `groupId` above is the first of these and stays
  /// the one the hot read paths denormalise; a combined lecture lists the
  /// rest here rather than needing a synthetic "all sections" group.
  groups      EventGroup[]

  @@index([orgId, roomId])
  @@index([groupId])
  @@index([facultyId])
  @@index([semesterId])
  @@index([courseId])
  @@index([orgId, kind, status])
}

/// An override for one occurrence of a series, keyed by the occurrence's
/// original start instant (iCal RECURRENCE-ID). Covers both "skip this one"
/// (EXDATE) and "this one is different".
model EventException {
  id            String        @id @default(cuid())
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  originalStart DateTime
  type          ExceptionType

  // Overrides, only meaningful for MODIFIED. Null means "inherit from series".
  newStartTime DateTime?
  newEndTime   DateTime?
  newRoomId    String?
  newTitle     String?
  newFacultyId String?

  reason    String?
  createdAt DateTime @default(now())

  occurrence EventOccurrence?

  @@unique([eventId, originalStart])
}

/// Materialised expansion of every Event. Rebuilt inside the same transaction
/// as any write to its Event or that Event's exceptions, so readers never deal
/// with recurrence rules. Every scheduling query hits this table alone.
model EventOccurrence {
  id      String       @id @default(cuid())
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id])
  eventId String
  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  start DateTime
  end   DateTime

  // Effective values after any exception is applied, denormalised so the hot
  // queries (grid, conflicts, availability) need no joins.
  roomId    String
  room      Room            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  groupId   String?
  group     Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  facultyId String?
  faculty   FacultyProfile? @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  kind      EventKind
  /// CANCELLED rows are kept so the UI can show a ghost and offer restore;
  /// every scheduling query filters them out.
  status    EventStatus

  exceptionId String?         @unique
  exception   EventException? @relation(fields: [exceptionId], references: [id], onDelete: SetNull)

  attendance AttendanceSession[]

  @@index([roomId, start])
  @@index([facultyId, start])
  @@index([groupId, start])
  @@index([orgId, start])
  @@index([eventId])
}

/// A group that attends an event. One row per group, including the primary one.
model EventGroup {
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([eventId, groupId])
  @@index([groupId])
}

// ─── Attendance ─────────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/**
 * One group's register for one occurrence of a lecture.
 * Keyed on the occurrence rather than the event, because attendance is taken
 * per sitting; and on the group as well, because a combined lecture is two
 * registers taken in the same room at the same time, and each is the concern of
 * a different set of students.
 */
model AttendanceSession {
  id           String          @id @default(cuid())
  orgId        String
  org          Organization    @relation(fields: [orgId], references: [id])
  occurrenceId String
  occurrence   EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  groupId      String
  group        Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)

  markedById String?
  markedBy   User?    @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  markedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt
  notes      String?

  records AttendanceRecord[]

  @@unique([occurrenceId, groupId])
  @@index([orgId, markedAt])
  @@index([groupId])
}

model AttendanceRecord {
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus  @default(PRESENT)
  note      String?

  @@id([sessionId, studentId])
  @@index([studentId])
}

// ─── Schedule builder ───────────────────────────────────────────────────────

/**
 * A plan never touches `Event`. It is a *weekly pattern* — its sessions carry a
 * weekday and minutes from midnight, not instants — and only becomes real
 * classes when someone applies it, which is the single operation in this
 * section that writes to the live timetable.
 */
enum PlanStatus {
  /// Visible to its creator alone.
  DRAFT
  /// Shared: anyone with planner access can read it, reviewers can respond.
  IN_REVIEW
  /// Every invited reviewer approved. Only now may it be applied.
  APPROVED
  /// A reviewer asked for changes; revise it into a fresh draft.
  CHANGES_REQUESTED
  /// Written to the live timetable. Frozen from here on.
  APPLIED
  ARCHIVED
}

enum PlanDecision {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

model SchedulePlan {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name   String
  status PlanStatus @default(DRAFT)
  notes  String?

  semesterId String?
  semester   Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  /**
   * Revision chain. Feedback belongs to one draft: revising copies the demand
   * and the placements into a new row and leaves the comments and approvals
   * behind, so an approval can never be inherited by a plan nobody read.
   * `rootId` is the first draft in the chain, which makes "every version of
   * this plan" a single indexed query.
   */
  version  Int           @default(1)
  rootId   String?
  parentId String?       @unique
  parent   SchedulePlan? @relation("PlanRevision", fields: [parentId], references: [id], onDelete: SetNull)
  revision SchedulePlan? @relation("PlanRevision")

  createdById String?
  createdBy   User?   @relation("PlanCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// The Monday the weekly pattern hangs off, and how far it repeats once
  /// applied. Dates in the org's timezone; the time of day comes from sessions.
  weekStart   DateTime  @db.Date
  repeatUntil DateTime? @db.Date

  /**
   * The scheduling rules this plan was built against, copied from OrgSettings
   * when it was created. Snapshotted rather than read live, so that shortening
   * the working day cannot silently invalidate a plan already under review.
   */
  slotMinutes     Int
  dayStartMinutes Int
  dayEndMinutes   Int
  workingDays     Int[]

  /// Most sessions one group may be given in a day. 0 means no cap.
  maxPerDay            Int     @default(0)
  /// Prefer to put a subject's weekly sessions on different days.
  spreadAcrossDays     Boolean @default(true)
  /// Treat what is already timetabled as occupied when placing.
  respectLiveTimetable Boolean @default(true)

  sharedAt    DateTime?
  generatedAt DateTime?
  appliedAt   DateTime?
  /// Plain id: who applied it is an audit fact, not a live relationship.
  appliedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements SchedulePlanRequirement[]
  sessions     SchedulePlanSession[]
  reviewers    SchedulePlanReviewer[]
  comments     SchedulePlanComment[]

  @@index([orgId, status])
  @@index([orgId, rootId])
  @@index([createdById])
}

/// One line of demand: "BCA-A needs 3 Data Structures lectures a week, taught by
/// Dr. Rao, in a room with a projector".
model SchedulePlanRequirement {
  id     String       @id @default(cuid())
  planId String
  plan   SchedulePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// What is being taught. Becomes the class title.
  subject         String
  sessionsPerWeek Int
  durationMinutes Int    @default(60)

  /**
   * Who has to be free for it. Ids rather than a join table on purpose: a plan
   * is a proposal about the future, and someone leaving must not silently
   * rewrite one already under review. Names are resolved on read, and an id
   * that no longer resolves is reported rather than quietly dropped.
   */
  facultyIds String[]

  /// What the room has to be. All empty means anything free will do.
  requiredFeatures RoomFeature[]
  roomType         RoomType?
  minCapacity      Int?
  preferredRoomId  String?
  preferredRoom    Room?         @relation(fields: [preferredRoomId], references: [id], onDelete: SetNull)

  /// Line of the uploaded file this came from, for error reporting.
  sourceLine Int?
  notes      String?
  position   Int     @default(0)

  sessions SchedulePlanSession[]

  @@index([planId, position])
  @@index([groupId])
}

/**
 * One proposed lecture. `dayOfWeek` and `startMinutes` are null when the solver
 * could not fit it — an unplaced session is kept, with a reason, because "these
 * four will not fit" is the most useful thing a plan can tell a scheduler.
 */
model SchedulePlanSession {
  id     String       @id @default(cuid())
  planId String
  plan   SchedulePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  requirementId String?
  requirement   SchedulePlanRequirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  title      String
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  facultyIds String[]

  /// ISO weekday, 1 = Monday … 7 = Sunday, and minutes from local midnight.
  dayOfWeek       Int?
  startMinutes    Int?
  durationMinutes Int

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  /// Why it could not be placed, or why it is flagged.
  reason String?
  /// Hand-placed: regenerating leaves it exactly where it is.
  pinned Boolean @default(false)

  /// The class this became. A plain id, so cancelling that class later does
  /// not erase the record of what the plan did.
  appliedEventId String?

  comments SchedulePlanComment[]

  @@index([planId, dayOfWeek, startMinutes])
  @@index([requirementId])
  @@index([groupId])
}

/// Someone asked to sign a draft off. One row per invited reviewer per draft.
model SchedulePlanReviewer {
  planId String
  plan   SchedulePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  decision  PlanDecision @default(PENDING)
  decidedAt DateTime?
  /// What they said when they decided, shown beside the decision.
  note      String?
  invitedAt DateTime     @default(now())

  @@id([planId, userId])
  @@index([userId])
}

/// Feedback on a draft, optionally pinned to one proposed session.
model SchedulePlanComment {
  id     String       @id @default(cuid())
  planId String
  plan   SchedulePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  sessionId String?
  session   SchedulePlanSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("PlanCommenter", fields: [authorId], references: [id], onDelete: SetNull)

  body       String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([planId, createdAt])
  @@index([sessionId])
}

// ─── Operations ─────────────────────────────────────────────────────────────

/// Transactional outbox: rows are written in the same transaction as the
/// booking they notify about, then dispatched after the response and swept by
/// a cron retry. Guarantees at-least-once delivery with only Postgres.
model EmailOutbox {
  id      String  @id @default(cuid())
  toEmail String
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type    EmailType
  payload Json

  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  createdAt DateTime    @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

/// Audit trail for CSV bulk imports.
model ImportBatch {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  fileName String?
  created  Int
  updated  Int
  skipped  Int
  errors   Json?

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

// ─── Google Calendar sync ───────────────────────────────────────────────────

enum CalendarSyncStatus {
  /// Tokens are good and work is being drained normally.
  ACTIVE
  /// Google refused the refresh token — consent withdrawn, password reset, or
  /// the account was suspended. Only reconnecting fixes it, so we stop trying.
  REVOKED
  /// Switched off by the person themselves. Their mirrored events have been
  /// removed; the row is kept so reconnecting is one click rather than a
  /// fresh consent screen.
  PAUSED
}

enum CalendarTaskStatus {
  PENDING
  DONE
  /// Out of attempts. Kept rather than deleted: a row that failed twenty times
  /// is the only evidence of why somebody's calendar is wrong.
  FAILED
}

/// One person's connected Google Calendar.
///
/// Separate from `Account` on purpose. That row is NextAuth's and describes how
/// somebody signs in; this one describes a standing permission they granted
/// afterwards, which they can withdraw without losing their login. Keeping the
/// two apart is also what lets sign-in stay on the narrow scopes it has always
/// asked for — see `src/server/services/calendar/oauth.ts`.
model CalendarConnection {
  id     String       @id @default(cuid())
  userId String       @unique
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id])

  /// Google's immutable `sub`. The address can change under a rename; this
  /// cannot, so it is what tells us the person reconnected a *different*
  /// account and their old mirrors belong to a calendar we can no longer reach.
  googleSub   String
  googleEmail String

  /// Sealed with AES-256-GCM before it ever reaches the database — see
  /// `calendar/crypto.ts`. A refresh token is a standing write permission on
  /// somebody's calendar, which is worth more than a session cookie.
  refreshToken    String
  accessToken     String?
  accessExpiresAt DateTime?

  /// The secondary calendar we create and own, never the primary. Deleting it
  /// in Google is a complete, one-click undo of everything we ever wrote, and
  /// nothing of theirs is mixed in with it.
  calendarId String?

  status    CalendarSyncStatus @default(ACTIVE)
  lastError String?
  /// When a full pass last completed, which is what the rolling horizon sweep
  /// orders by — see `sweepStaleConnections`.
  syncedAt  DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  mirrors CalendarMirror[]
  tasks   CalendarSyncTask[]

  @@index([status, syncedAt])
  @@index([orgId])
}

/// One occurrence, as it currently stands in one person's Google Calendar.
///
/// Keyed on `(eventId, originalStart)` rather than on the occurrence id, and
/// that is not a detail: `regenerateOccurrences` keeps a sitting's row through
/// ordinary edits, but a series that is retimed or split gets new rows, so an
/// occurrence id is not a name that lasts.
/// `originalStart` — the slot the recurrence rule produced, before any
/// exception moved it — does survive, and is what lets a reschedule become a
/// patch of the same Google event rather than a delete and a re-create that
/// would throw away the reminder somebody had set on it.
model CalendarMirror {
  id           String             @id @default(cuid())
  connectionId String
  connection   CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  /// Not a foreign key, and that is the point. A mirror records something that
  /// exists in *Google*, so it must outlive the local row it came from: cascade
  /// away the mirror when an event is deleted and the `googleEventId` needed to
  /// clean up goes with it, leaving a ghost lecture in somebody's calendar for
  /// ever. Reconcile treats "no occurrences for this event" as "delete these",
  /// which handles a deleted event and an emptied series identically.
  eventId       String
  originalStart DateTime

  /// The id Google gave the event we created.
  googleEventId String
  /// Fingerprint of what we last pushed. An occurrence whose digest is
  /// unchanged costs no API call at all, which is what makes a resync of an
  /// untouched timetable nearly free.
  digest        String

  updatedAt DateTime @updatedAt

  @@unique([connectionId, eventId, originalStart])
  @@index([connectionId])
  @@index([eventId])
}

/// Work owed to somebody's calendar: "this person's mirror of this event is out
/// of date".
///
/// Deliberately coarse. A row per *occurrence* would mean 40 rows per student
/// for one edit to a semester-long class — 2,400 for a lecture of sixty. One
/// row per (person, event) collapses that to sixty, and the reconcile it
/// triggers diffs digests, so the fan-out costs writes only where something
/// actually changed.
///
/// The unique constraint is what makes re-dirtying idempotent: editing an event
/// five times before the cron next runs leaves one pending row, not five.
model CalendarSyncTask {
  id           String             @id @default(cuid())
  connectionId String
  connection   CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Plain string for the same reason as `CalendarMirror.eventId`: the work of
  /// removing a deleted event from sixty calendars must survive the deletion.
  eventId      String

  status        CalendarTaskStatus @default(PENDING)
  attempts      Int                @default(0)
  /// Exponential backoff. The drain never picks up a row before this.
  nextAttemptAt DateTime           @default(now())
  lastError     String?
  createdAt     DateTime           @default(now())

  @@unique([connectionId, eventId])
  @@index([status, nextAttemptAt])
}

// ─── Notifications ──────────────────────────────────────────────────────────

/// What a notification is about. Each one is a row on the settings tab, with a
/// switch for the inbox and a switch for push, so somebody can keep hearing
/// about their classes on their phone and read everything else in Plannr.
enum NotificationCategory {
  /// A class you attend or teach moved, was called off, was added or is back.
  CLASS_CHANGES
  /// A booking or a change you asked for was approved or declined.
  REQUESTS
  /// A booking or a change is waiting for you to approve it.
  APPROVALS
  /// A schedule plan wants your review, or a plan of yours was reviewed.
  PLAN_REVIEWS
}

/// One piece of news for one person: a row in their inbox, and the push it
/// owes their devices.
///
/// A row per person rather than per audience, because "read" is per person. A
/// class change reaching sixty students is sixty rows, which is the price of
/// sixty people each being able to clear it.
model Notification {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  category  NotificationCategory
  title     String
  body      String
  /// Where opening it takes you, as a path inside the app.
  url       String
  /// What it is news of, for example "class-change:<notice id>". Unique per
  /// person, so the same news written twice (a retried dispatch, two clicks on
  /// Approve) reaches them once.
  sourceKey String?

  /// False when the person has the inbox off for this category but still wants
  /// it pushed: the row exists to carry the push and is never listed.
  inInbox Boolean   @default(true)
  readAt  DateTime?

  /// A push is owed to this person's devices and has not been sent yet. Cleared
  /// when it is sent, when it can never be, and when it is given up on.
  pushPending   Boolean   @default(false)
  /// A lease on the push, so two dispatchers never send the same one and a
  /// dispatcher that dies mid-send only delays it.
  pushClaimedAt DateTime?
  pushAttempts  Int       @default(0)
  pushedAt      DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, sourceKey])
  @@index([userId, inInbox, createdAt])
  @@index([userId, readAt])
  @@index([pushPending, createdAt])
}

/// Somebody's own choice for one category. No row means the category's
/// default, which is everything on: a person who never opens the settings tab
/// still hears about their classes.
model NotificationPreference {
  userId   String
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category NotificationCategory
  inApp    Boolean              @default(true)
  push     Boolean              @default(true)

  updatedAt DateTime @updatedAt

  @@id([userId, category])
}

// ─── Push notifications ─────────────────────────────────────────────────────

/// One browser on one device that has said yes to notifications. The endpoint is
/// the push service's address for that browser and is unique by construction, so
/// signing in as somebody else on the same phone moves the row rather than
/// doubling it. `p256dh` and `auth` are the browser's keys for encrypting what
/// is sent: the push service relays the message and cannot read it.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String  @unique
  p256dh    String
  auth      String
  userAgent String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

enum ClassChangeKind {
  MOVED
  CANCELLED
  ADDED
  RESTORED
}

/// A class change somebody should be told about, written in the same
/// transaction as the edit that caused it, so the edit commits or nothing is
/// queued. Who to tell is held as the groups and teachers it concerned at the
/// moment of the edit, so a lecture moved between sections reaches both. The
/// event is a plain id, not a relation: the notice outlives a deleted event.
model ClassChangeNotice {
  id      String @id @default(cuid())
  eventId String

  kind       ClassChangeKind
  title      String
  body       String
  /// Where tapping the notification opens.
  url        String
  groupIds   String[]
  facultyIds String[]

  createdAt DateTime  @default(now())
  /// Set when a dispatcher takes the notice; a lease, so a crashed one does not
  /// hold it for ever (see `dispatchPending`).
  claimedAt DateTime?
  sentAt    DateTime?
  attempts  Int       @default(0)

  @@index([sentAt, createdAt])
}

// ─── Public API ─────────────────────────────────────────────────────────────

/// A credential an app authenticates with, and the identity it acts as.
///
/// A key is a *service principal*, not a stand-in for the admin who minted it:
/// it carries its own permission bits and answers for itself in the audit
/// trail. The `principal` is what makes that possible — a `User` row flagged
/// `isServiceAccount`, holding no roles and no password, existing so that
/// "who created this booking?" has an answer that is neither a lie about a
/// person nor a null. Ownership rules therefore work unchanged: a key owns
/// what it created and nothing else, which is why `ManageOwnEvents` on its own
/// grants a key almost nothing and the `*All*` bits are the useful scopes.
///
/// The secret is shown once, at creation, and never stored — only its SHA-256.
/// A leaked database therefore yields no working credentials.
model ApiKey {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name        String
  description String?

  /// The public half, and the whole token's first segment: "plk_live_a1b2c3d4".
  /// Safe to log and to show in a list, and enough to look a key up in one
  /// indexed hit before any hashing happens.
  prefix String @unique
  /// SHA-256 of the secret half, hex. Compared in constant time.
  hash   String
  /// Last four characters of the secret, so a person holding several keys can
  /// tell which is which without the app having to remember any of them.
  last4  String

  /// The machine identity. Cascades: deleting the key deletes the principal
  /// through the application, and a principal without its key is meaningless.
  principalId String @unique
  principal   User   @relation("ApiKeyPrincipal", fields: [principalId], references: [id], onDelete: Cascade)

  /// The person this key speaks for, for a personal key; null for the service
  /// keys an administrator mints.
  ///
  /// A personal key still gets a principal of its own, and that is deliberate
  /// rather than redundant: `principalId` is unique, so a principal that *was*
  /// the owner would cap every student at one key for ever, and the row is also
  /// what the audit columns and the rate-limit window hang off. The principal
  /// is the credential's identity; the owner is whose timetable it may read.
  ///
  /// Cascades, because a key that speaks for somebody who no longer exists is a
  /// credential with no one to answer for it.
  ownerId String?
  owner   User?   @relation("ApiKeyOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  /// Permission bitfield, in exactly the vocabulary of src/lib/permissions.ts.
  /// Never widened by roles — a key holds these bits and no others.
  scopes BigInt @default(0)

  createdById String?
  createdBy   User?   @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// Null means it never expires, which is a choice the UI makes you make.
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedById String?
  revokedBy   User?     @relation("ApiKeyRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  lastUsedAt   DateTime?
  lastUsedIp   String?
  requestCount Int       @default(0)

  /// Fixed-window throttle, counted on the row itself. In-process counters are
  /// useless on serverless — every request may land on a cold instance — so the
  /// window lives where all instances can see it, and costs the one write the
  /// `lastUsedAt` bump was going to make anyway.
  rateLimitPerMinute Int       @default(120)
  windowStartedAt    DateTime?
  windowCount        Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, createdAt])
  @@index([orgId, revokedAt])
  /// Every read of a personal key starts "whose is this?" — the owner's own
  /// list, and the console's filter that keeps students' phones out of the
  /// institution's credential register.
  @@index([ownerId])
}
