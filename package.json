{
  "name": "plannr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "prisma generate && next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "next dev --turbo -p 3000",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:import": "tsx prisma/import-sicsr.ts",
    "db:sync-schedule": "tsx prisma/sync-schedule.ts",
    "db:cancel-classes": "tsx prisma/cancel-classes.ts",
    "db:split-sections": "tsx prisma/split-elective-sections.ts",
    "db:verify-schedule": "tsx prisma/verify-schedule.ts",
    "roster": "tsx prisma/build-roster.ts",
    "db:students": "tsx prisma/import-students.ts",
    "db:courses": "tsx prisma/build-courses.ts",
    "db:faculty": "tsx prisma/import-faculty.ts",
    "db:start": "docker compose -f docker-compose.dev.yml up -d",
    "db:stop": "docker compose -f docker-compose.dev.yml down",
    "email:dev": "email dev --dir src/emails"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.7.1",
    "@myriaddreamin/typst-ts-node-compiler": "0.7.0",
    "@prisma/client": "^6.6.0",
    "@react-email/components": "^1.0.12",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@tanstack/react-table": "^9.1.2",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "date-fns": "^4.4.0",
    "next": "^15.2.3",
    "next-auth": "5.0.0-beta.25",
    "nuqs": "^2.9.5",
    "papaparse": "^5.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.85.0",
    "resend": "^6.18.1",
    "rrule": "^2.8.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20.14.10",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "happy-dom": "^15.11.7",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.6.0",
    "react-email": "^6.9.2",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.12",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^4.1.10"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@11.17.0",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
