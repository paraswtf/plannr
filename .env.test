# The database the integration tests run against. Layered over .env by
# vitest.integration.config.ts, which refuses to run against a non-local host.
#
# Committed on purpose, unlike .env: these are the throwaway credentials of the
# Docker container `npm run db:start` brings up, and the suite is safer when
# every clone gets them rather than falling back to whatever .env points at.
DATABASE_URL="postgresql://postgres:password@localhost:5433/plannr"
DIRECT_URL="postgresql://postgres:password@localhost:5433/plannr"
